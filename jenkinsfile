pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t jyothi-nginx .'
            }
        }

        stage('Test') {
            steps {
                sh 'docker images'
            }
        }
    }
}
